# PDA Runtime Environment Template
#
# Copy the relevant values into your local, ignored secret file or secret store.
# Do not commit real secrets, API keys, tokens, or passwords.
#
# Current compose stack still reads litellm/.env.local. This template documents
# the portable values required for a clean workstation migration.

# Repository / vault paths
PDA_ROOT=C:\Path\To\AI Ecosystem
OBSIDIAN_VAULT_PATH=C:\Path\To\AI Ecosystem\Obsidian Vault
PDA_BACKUPS_ROOT=C:\Path\To\AI Ecosystem\PDA-Backups
PDA_TASKS_ROOT=C:\Path\To\AI Ecosystem\PDA-Tasks

# Local service endpoints
OPEN_WEBUI_URL=http://localhost:3000
LITELLM_URL=http://localhost:4000/v1
N8N_URL=http://localhost:5678
OLLAMA_URL=http://localhost:11434
N8N_RESTRICT_FILE_ACCESS_TO=/files

# LiteLLM provider secrets (placeholders only)
# LITELLM_MASTER_KEY must be set HERE (in PDA-Runtime/.env, copied from this template) AND
# match the value set in litellm/.env.local exactly. docker-compose.yml's
# ${LITELLM_MASTER_KEY:-cooper-local} for the Open Workshop's cooper-core service is resolved
# from THIS file (or the shell env) at Compose parse time -- it does not read litellm/.env.local,
# which only populates the litellm container's own runtime env. If the two values diverge,
# cooper-core's /chat calls will be rejected by LiteLLM with a 401.
LITELLM_MASTER_KEY=YOUR_LITELLM_MASTER_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Optional integration secrets (placeholders only)
WEBUI_SECRET_KEY=YOUR_WEBUI_SECRET_KEY
N8N_ENCRYPTION_KEY=YOUR_N8N_ENCRYPTION_KEY

# Step 12 — Signal gateway (Open Workshop only). Leave GATEWAY_ENABLED=0 to disable.
GATEWAY_ENABLED=0
SIGNAL_NUMBER=            # e.g. +15550001111 — the account COOPER sends as
SIGNAL_ALLOWED_SENDERS=   # comma-separated sender numbers; EMPTY = nobody (fail closed)
