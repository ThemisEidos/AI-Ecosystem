# PDA Runtime Environment Template
#
# Copy the relevant values into your local, ignored secret file or secret store.
# Do not commit real secrets, API keys, tokens, or passwords.
#
# Current compose stack still reads litellm/.env.local. This template documents
# the portable values required for a clean workstation migration.

# Repository / vault paths
PDA_ROOT=C:\Path\To\AI Ecosystem
OBSIDIAN_VAULT_PATH=C:\Path\To\AI Ecosystem\Obsidian Vault
PDA_BACKUPS_ROOT=C:\Path\To\AI Ecosystem\PDA-Backups
PDA_TASKS_ROOT=C:\Path\To\AI Ecosystem\PDA-Tasks

# Local service endpoints
OPEN_WEBUI_URL=http://localhost:3000
LITELLM_URL=http://localhost:4000/v1
N8N_URL=http://localhost:5678
OLLAMA_URL=http://localhost:11434
N8N_RESTRICT_FILE_ACCESS_TO=/files

# LiteLLM provider secrets (placeholders only)
LITELLM_MASTER_KEY=YOUR_LITELLM_MASTER_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Optional integration secrets (placeholders only)
WEBUI_SECRET_KEY=YOUR_WEBUI_SECRET_KEY
N8N_ENCRYPTION_KEY=YOUR_N8N_ENCRYPTION_KEY
