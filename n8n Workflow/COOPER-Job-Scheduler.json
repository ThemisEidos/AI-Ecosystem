{
  "id": "cooperJobScheduler01",
  "name": "COOPER Job Scheduler",
  "nodes": [
    {
      "id": "trigger-news-reel",
      "name": "Schedule \u2014 news-reel",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "notes": "Daily 06:30",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 6 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "http-news-reel",
      "name": "Run news-reel",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "notes": "cooper-core refuses an unapproved job; the approval gate does the gating.",
      "parameters": {
        "method": "POST",
        "url": "http://cooper-core:8000/jobs/run/news-reel",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.COOPER_API_KEY }}"
            }
          ]
        },
        "sendBody": false,
        "options": {
          "timeout": 600000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "trigger-repo-steward",
      "name": "Schedule \u2014 repo-steward",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        220
      ],
      "notes": "Daily 07:00",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "http-repo-steward",
      "name": "Run repo-steward",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        220
      ],
      "notes": "cooper-core refuses an unapproved job; the approval gate does the gating.",
      "parameters": {
        "method": "POST",
        "url": "http://cooper-core:8000/jobs/run/repo-steward",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.COOPER_API_KEY }}"
            }
          ]
        },
        "sendBody": false,
        "options": {
          "timeout": 600000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    }
  ],
  "connections": {
    "Schedule \u2014 news-reel": {
      "main": [
        [
          {
            "node": "Run news-reel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Schedule \u2014 repo-steward": {
      "main": [
        [
          {
            "node": "Run repo-steward",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
