{
  "id": "cooperJobScheduler01",
  "name": "COOPER Job Scheduler",
  "nodes": [
    {
      "id": "trigger-link-checker",
      "name": "Schedule \u2014 link-checker",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * *"
            }
          ]
        }
      },
      "notes": "Daily 03:00"
    },
    {
      "id": "http-link-checker",
      "name": "Run link-checker",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://cooper-core:8000/jobs/run/link-checker",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.COOPER_API_KEY }}"
            }
          ]
        },
        "sendBody": false,
        "options": {
          "timeout": 600000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "notes": "cooper-core refuses an unapproved job; the approval gate does the gating, not the schedule."
    },
    {
      "id": "trigger-data-broker-research",
      "name": "Schedule \u2014 data-broker-research",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "5 0 * * *"
            }
          ]
        }
      },
      "notes": "Daily 00:05 + random delay (lands 00:05-05:55)"
    },
    {
      "id": "wait-data-broker-research",
      "name": "Randomize \u2014 data-broker-research",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        280,
        220
      ],
      "webhookId": "cooper-wait-data-broker-research",
      "parameters": {
        "amount": "={{ Math.floor(Math.random() * 350) }}",
        "unit": "minutes"
      },
      "notes": "Spec asks this job to run at a randomized time; this spreads it across a 350-minute window."
    },
    {
      "id": "http-data-broker-research",
      "name": "Run data-broker-research",
