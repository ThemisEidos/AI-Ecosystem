{
  "schema_version": "1.0",
  "policy_name": "PDA Build Runner Policy",
  "legacy_policy_name": "PDA Nightly Execution Policy",
  "runner_name": "PDA Build Runner",
  "legacy_runner_name": "PDA Nightly Build Orchestrator",
  "modes": [
    "dry-run",
    "prepare",
    "execute",
    "unattended"
  ],
  "max_tasks_per_run": 1,
  "MaxTasks": 1,
  "max_runtime_minutes": 120,
  "MaxRuntimeMinutes": 120,
  "stop_on_failed_tests": true,
  "StopOnFailure": true,
  "allowed_file_globs": [
    "Scripts/**",
    "Roadmap/**",
    "Documentation/**",
    "Obsidian Vault/**",
    "PDA-Tasks/**",
    "PDA-Backups/**",
    "setup-pda-profile.ps1"
  ],
  "blocked_file_globs": [
    "**/.env*",
    "**/secrets/**",
    "PDA-Runtime/data/**",
    "workers.json",
    "Timeline Builder*.json"
  ],
  "require_clean_start": true,
  "branch_prefix": "codex/build-runner/",
  "allow_commit_to_branch": false,
  "allow_push_branch": false,
  "allow_main_mod": false,
  "allow_secret_changes": false,
  "max_retries_per_task": 2,
  "monitor_interval_seconds": 30,
  "stalled_run_timeout_minutes": 15,
  "recovery_report_root": "PDA-Backups/build-runner/logs",
  "RunReport": "PDA-Backups/build-runner/reports",
  "retryable_failure_patterns": [
    "exception",
    "error",
    "failed",
    "fatal",
    "timeout",
    "stalled",
    "crash"
  ],
  "safety_gates": [
    "No auto-commit unless policy allows",
    "No auto-push unless policy allows",
    "No approval bypass",
    "Stop on dirty worktree",
    "Stop on failed tests",
    "Stop on blocked policy actions"
  ],
  "trigger_command": "pda-go",
  "documentation_note": "Build Runner is the time-agnostic replacement for nightly scheduling. Legacy nightly wrappers remain supported for backward compatibility."
}
